# ─────────────────────────────────────────────
# API WEBCUP — variables d'environnement
# Copier ce fichier en .env : cp .env.example .env
# ─────────────────────────────────────────────

# Serveur HTTP (index.ts)
PORT=5000

# Origine autorisée par le CORS (index.ts) -> URL du front Next.js
CLIENT_URL=http://localhost:3000


# ── Base de données PostgreSQL ───────────────
# DATABASE_URL est prioritaire (config/database.ts) : c'est le format des plateformes
# managées (Supabase, Neon, Railway). Les DB_* ne servent que de repli si elle est absente.
# Le mot de passe doit être encodé en URL s'il contient @ : / # ?
# DATABASE_URL=postgres://webcup:motdepasse@127.0.0.1:5432/webcup
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=webcup
DB_PASSWORD=
DB_NAME=webcup



# ── Authentification JWT ─────────────────────
# Secret de signature des access tokens (config/auth.ts)
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
# Durée de vie de l'access token (format jsonwebtoken : 15m, 1h, 7d...)
JWT_ACCESS_EXPIRES_IN=1h
# Durée de vie du refresh token, en jours
REFRESH_TOKEN_EXPIRES_DAYS=10


# Chiffrement au repos du secret TOTP (double authentification citoyenne, voir utils/crypto.ts).
# Optionnel : sans valeur, une clé est dérivée de JWT_ACCESS_SECRET. La fournir sépare les deux
# usages (signature des jetons / chiffrement des secrets 2FA).
# TWO_FACTOR_ENC_KEY=

# ── Débogage ──────────────────────────────────
# true : les réponses 500 contiennent la cause de l'erreur (error, hint, detail).
# Uniquement pour diagnostiquer un déploiement, à remettre à false ensuite.
EXPOSE_ERRORS=false


# ── Données de base ───────────────────────────
# Au démarrage, crée les rôles, permissions et services municipaux manquants (idempotent, ne touche pas
# aux réglages faits ensuite par un admin). false : désactive ce seed automatique.
SEED_ON_START=true


# ── Audit ─────────────────────────────────────
# Enregistre chaque requête dans audit_logs (écriture en lot, sans ralentir les réponses).
# all : toutes les requêtes (défaut) | writes : écritures + refus 401/403 | off : désactivé
AUDIT_REQUESTS=all
NODE_ENV=development

OPEN_CODE_API_KEY=

# ── Charge et résilience ─────────────────────
# Connexions PostgreSQL maximum du pool de cette instance (défaut 10)
DB_POOL_MAX=10
# Nombre de proxys de confiance devant l'API (ex. 1 chez un hébergeur). À régler AVANT d'activer
# la limitation de débit, sinon tous les habitants partagent l'adresse IP du proxy.
# TRUST_PROXY=1
# Temps réel (socket.io) : connexions par adresse IP (défaut 50) et au total (défaut 5000)
# REALTIME_MAX_CONNECTIONS_PER_IP=50
# REALTIME_MAX_CONNECTIONS=5000

# ── Transports et résilience en cas de panne ─────────────────────────────────
# Fuseau des horaires de transport (défaut : celui du serveur)
# TRANSPORT_TIMEZONE=Indian/Antananarivo
# Copies de secours des informations publiques (alertes, transports, kit essentiel), servies si la base tombe
# SNAPSHOT_DIR=data/snapshots
# Au-delà de ce délai, une lecture publique est servie depuis sa copie de secours
# DB_READ_TIMEOUT_MS=3000
# Avis d'incident sur la plateforme (fichier, pas base : lisible et modifiable même si la base est en panne)
# PLATFORM_NOTICE_FILE=data/platform-notice.json
# Limitation de débit par adresse IP (désactivée si absente) :
# RATE_LIMIT_PER_MINUTE=600
# LOGIN_RATE_LIMIT_PER_15MIN=30
# Hachage des mots de passe (le calcul le plus coûteux de l'API, voir README « Charge et stabilité »).
# Taille du thread pool de Node : à poser dans l'ENVIRONNEMENT DU PROCESSUS (sous tsx/nodemon c'est fait par
# nodemon.json ; en production avec `node dist/index.js`, config/runtime.ts s'en charge s'il est absent).
# UV_THREADPOOL_SIZE=16
# Hachages réellement simultanés (défaut : cœurs - 1, toujours sous la taille du pool) ; file d'attente max
# avant de répondre 503 + Retry-After, et attente maximale dans cette file :
# HASH_CONCURRENCY=7
# HASH_QUEUE_MAX=400
# HASH_QUEUE_TIMEOUT_MS=8000
# Journal des requêtes : all (défaut en développement) | errors (défaut en production : statuts >= 400 et
# requêtes plus lentes que LOG_SLOW_MS) | off
# LOG_REQUESTS=errors
# LOG_SLOW_MS=1000
# RESPONSE_CACHE=off désactive le cache serveur des listes (diagnostic d'une donnée qui paraît périmée)
# RESPONSE_CACHE=off

# ── Orientation des habitants (demandes d'« aide ») ────────────────────────
# Passerelle OpenAI-compatible utilisée pour orienter un habitant vers le service compétent.
# Sans OPENCODE_API_KEY, tout passe par le routage déterministe par mots-clés : l'orientation
# reste disponible et instantanée, seule la rédaction de la démarche manque.
# OPEN_CODE_API_KEY=   (OPENCODE_API_KEY est aussi accepté)
# La même clé sert à l'assistant de rédaction des alertes (POST /api/alerts/draft) :
# ALERT_AI_TIMEOUT_MS=20000
# AI_DRAFT_RATE_LIMIT_PER_MINUTE=10
# Les modèles gratuits de la passerelle sont éphémères ("available for a limited time") :
# le modèle est donc configurable, et sa réponse est validée avant d'être servie.
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=space-bunny-free
# Délai au-delà duquel le modèle est abandonné pour le repli par mots-clés.
# LLM_TIMEOUT_MS=8000
# Limitation de débit propre à l'orientation (défaut 10 par minute) :
# GUIDANCE_RATE_LIMIT_PER_MINUTE=10

# ── Protection anti-robots des formulaires (voir README) ─────────────────────
# on (défaut) : bloque | monitor : détecte, journalise et audite SANS bloquer (mesurer avant d'activer, ou diagnostiquer
# un faux positif) | off : désactive. En "on", un formulaire protégé sans jeton est refusé : un script ou un test
# (Postman, curl) doit joindre X-Form-Token, ou tourner avec BOT_PROTECTION=monitor / off.
# BOT_PROTECTION=on
# Adresses jamais bloquées (bureaux, supervision, tests), séparées par des virgules :
# BOT_ALLOWLIST=203.0.113.5
# Réglages fins (valeurs par défaut) : points avant blocage, envois/minute/IP (inscription, autres), échecs de connexion/10 min/IP
# BOT_BLOCK_THRESHOLD=8
# BOT_VELOCITY_REGISTER_PER_MINUTE=10
# BOT_VELOCITY_PER_MINUTE=30
# BOT_LOGIN_FAILURES=30

# ── Limite d'envois par compte ───────────────
# Envois par utilisateur connecté et par 10 minutes (demandes, messages, avis ; défaut 10, 0 = désactivé)
# WRITE_RATE_LIMIT_PER_10MIN=10

# ── Sécurité web (voir README, « Sécurité web ») ─────────────────────────────
# Détection des sondes d'attaque (injections SQL, traversée de répertoire, scanners...) :
# on (défaut) refuse et bloque | monitor détecte et audite sans refuser | off désactive
# ATTACK_GUARD=on
# Inscription libre en agent : autorisée par défaut (choix de produit). false : seuls les administrateurs nomment les agents.
# ALLOW_AGENT_SELF_SIGNUP=true
# Agents inscrits seuls = « non validés » : coordonnées des citoyens masquées, comptes citoyens non modifiables,
# consultations plafonnées, jusqu'à validation par un administrateur. off : tous les agents sont considérés validés.
# AGENT_VALIDATION=on
# Consultations de dossiers de citoyens par minute et par compte (agent non validé / agent validé et admin)
# SENSITIVE_READS_UNVALIDATED_PER_MINUTE=30
# SENSITIVE_READS_PER_MINUTE=150
# JWT_ACCESS_SECRET : 32 caractères aléatoires au minimum (node -e "console.log(require('crypto').randomBytes(64).toString('hex'))").
# Un secret trop court est signalé au démarrage et REFUSÉ en production s'il fait moins de 16 caractères.

# ── Signalements (urgences, incidents) ──────────────────────────────────────
# Numéro des secours : conseil renvoyé au déclarant d'une urgence, page de secours, kit essentiel, consignes (défaut 112)
# EMERGENCY_NUMBER=112
# Signalements envoyés par compte et par 10 minutes (au-delà : 429, avec un message invitant à appeler les secours)
# SIGNALEMENT_RATE_LIMIT_PER_10MIN=20
